# Bybit API credentials — create a READ-ONLY key at
# https://www.bybit.com/app/user/api-management
# Do NOT enable "Trade" or "Withdraw" permission for this key; the watcher
# only needs to read order/execution/wallet updates.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# true = wss://stream-testnet.bybit.com (use a testnet API key/secret)
# false = wss://stream.bybit.com (real account)
BYBIT_TESTNET=false
