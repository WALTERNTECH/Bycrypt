# Customer app. Copy to .env.local for local work; set these in the Vercel
# project panel for a deployment. Never commit real values.

# --- Supabase (public; row-level security applies to these) ---
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# --- Supabase (server-only) ---
# Bypasses EVERY row-level security policy. Environment panel only: never in
# a file inside a web-served app root, and never in platform_config, which
# is world-readable.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# --- Admin alert emails (optional) ---
# Signup, deposit and withdrawal alerts are skipped when RESEND_API_KEY is
# absent; nothing else is affected.
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
ADMIN_APP_URL=https://your-admin-app.example.com

# --- Simulated market (optional, testing only) ---
# "1" makes an open position drift in its own favour so the settlement path
# can be exercised in minutes. Every screen carries a banner while it is on.
# DELETE THIS BEFORE PRODUCTION. See docs/DEPLOYMENT.md.
# NEXT_PUBLIC_KRYPTON_SIM_MARKET=1

# Market data needs no key. lib/market.ts reads public endpoints from Bybit,
# OKX, Coinbase and Binance and takes the first that answers — check which
# ones a deployment can reach at /api/health/market.

NODE_ENV=production
